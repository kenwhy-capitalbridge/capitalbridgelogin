NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: redirect to advisory app after login/signup (e.g. https://app.thecapitalbridge.com)
NEXT_PUBLIC_APP_URL=

# Optional: inactivity timeout in minutes before session expiry (default 30)
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# Billplz (subscription payments). Per-bill callback and redirect (no global webhook).
# BILLPLZ_CALLBACK_URL= your backend URL for webhook (e.g. https://your-login-domain.com/api/billplz-webhook)
# BILLPLZ_REDIRECT_URL= this app's payment-success page (e.g. https://your-login-domain.com/payment-success) so we can send user to platform or pricing
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Set to "true" to use Billplz sandbox
BILLPLZ_SANDBOX=

# Required for webhook: update memberships/payments (server-only)
SUPABASE_SERVICE_ROLE_KEY=
