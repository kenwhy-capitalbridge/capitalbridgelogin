NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: redirect to advisory app after login/signup (e.g. https://app.thecapitalbridge.com)
NEXT_PUBLIC_APP_URL=

# Optional: inactivity timeout in minutes before session expiry (default 30)
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# Billplz (subscription payments). Redirect/callback base (e.g. https://login.thecapitalbridge.com)
NEXT_PUBLIC_SITE_URL=
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# Set to "true" to use Billplz sandbox
BILLPLZ_SANDBOX=

# Required for webhook: update memberships/payments (server-only)
SUPABASE_SERVICE_ROLE_KEY=
